{
  "openapi": "3.1.0",
  "info": {
    "title": "Поиск по документам",
    "version": "1.0.0",
    "description": "Простой поисковик по текстам документов (PostgreSQL + Elasticsearch)."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "paths": {
    "/api/v1/documents/search": {
      "get": {
        "tags": [
          "Документы"
        ],
        "summary": "Поиск документов",
        "operationId": "search_documents",
        "description": "Ищет по тексту документа в индексе и возвращает до 20 самых релевантных документов со всеми полями БД, упорядоченных по дате создания (новые сверху).",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Текст запроса",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "title": "Query"
            },
            "example": "кот"
          }
        ],
        "responses": {
          "200": {
            "description": "Найденные документы",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "$ref": "#/components/schemas/DocumentOut"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Некорректный запрос",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents/{doc_id}": {
      "delete": {
        "tags": [
          "Документы"
        ],
        "summary": "Удаление документа",
        "operationId": "delete_document",
        "description": "Удаляет документ из БД и поискового индекса по id.",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Идентификатор документа"
            },
            "description": "Идентификатор документа"
          }
        ],
        "responses": {
          "204": {
            "description": "Документ удалён"
          },
          "404": {
            "description": "Документ не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Некорректный запрос",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DocumentOut": {
        "type": "object",
        "title": "Документ",
        "required": [
          "id",
          "rubrics",
          "text",
          "created_date"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "title": "Идентификатор",
            "example": 1
          },
          "rubrics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Рубрики",
            "example": [
              "VK-1603736028819866"
            ]
          },
          "text": {
            "type": "string",
            "title": "Текст",
            "example": "Моя кошка любит рыбу"
          },
          "created_date": {
            "type": "string",
            "format": "date-time",
            "title": "Дата создания",
            "example": "2019-07-04T19:30:46"
          }
        }
      },
      "ErrorOut": {
        "type": "object",
        "title": "Ошибка",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "title": "Описание ошибки",
            "example": "Документ не найден"
          }
        }
      }
    }
  }
}