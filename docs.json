{
  "openapi": "3.1.0",
  "info": {
    "title": "Document Search Service",
    "version": "1.0.0",
    "description": "Простой поисковик по текстам документов (PostgreSQL + Elasticsearch)."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "paths": {
    "/api/v1/documents/search": {
      "get": {
        "tags": [
          "documents"
        ],
        "summary": "Поиск документов",
        "operationId": "search_documents",
        "description": "Ищет по тексту документа в индексе и возвращает до 20 самых релевантных документов со всеми полями БД, упорядоченных по дате создания (новые сверху).",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Текст запроса",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "title": "Query"
            },
            "example": "кошка"
          }
        ],
        "responses": {
          "200": {
            "description": "Найденные документы",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "$ref": "#/components/schemas/DocumentOut"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents/{doc_id}": {
      "delete": {
        "tags": [
          "documents"
        ],
        "summary": "Удаление документа",
        "operationId": "delete_document",
        "description": "Удаляет документ из БД и поискового индекса по id.",
        "parameters": [
          {
            "name": "doc_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Doc Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Документ удалён"
          },
          "404": {
            "description": "Документ не найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Проверка работоспособности",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Сервис работает",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DocumentOut": {
        "type": "object",
        "title": "DocumentOut",
        "required": [
          "id",
          "rubrics",
          "text",
          "created_date"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "example": 1
          },
          "rubrics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "title": "Rubrics",
            "example": [
              "VK-1603736028819866"
            ]
          },
          "text": {
            "type": "string",
            "title": "Text",
            "example": "Моя кошка любит рыбу"
          },
          "created_date": {
            "type": "string",
            "format": "date-time",
            "title": "Created Date",
            "example": "2019-07-04T19:30:46"
          }
        }
      },
      "ErrorOut": {
        "type": "object",
        "title": "ErrorOut",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "example": "Document not found"
          }
        }
      },
      "HTTPValidationError": {
        "type": "object",
        "title": "HTTPValidationError",
        "properties": {
          "detail": {
            "type": "array",
            "title": "Detail",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "title": "ValidationError",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "properties": {
          "loc": {
            "type": "array",
            "title": "Location",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            }
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        }
      }
    }
  }
}